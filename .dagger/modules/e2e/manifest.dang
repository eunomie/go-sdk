"""Run the Go SDK against the helper under test."""
type ManifestChecks {
  """Generate a nested Go module, its local client, and its runtime schema."""
  localClientCheck(ws: Workspace!): Void @check {
    let scope = ".dagger/modules/e2e/fixtures/manifest/nested/app"
    let input = ws.withNewFile(scope + "/keep.txt", "keep").withWorkdir(scope)
    let target = ws.moduleSource("/.dagger/modules/e2e/fixtures/manifest/dep")
    let generated = goSdk.generateScope(ws: input, isModule: true, name: "app", clients: [target])
    let json = generated.file("dagger.json").contents
    let toml = generated.file("dagger-module.toml").contents
    self.assert(json.contains("\"source\": \"../../dep\""), "JSON dependency path is wrong")
    self.assert(toml.contains("source = \"../../dep\""), "TOML dependency path is wrong")
    self.assert(!json.contains("\"pin\":"), "JSON has a default pin")
    self.assert(!toml.contains("pin ="), "TOML has a default pin")
    self.assert(generated.file("keep.txt").contents == "keep", "generation changed an existing file")
    self.assert(generated.cwd == input.cwd, "generation changed the current directory")
    self.assert(generated.directory(".").exists("dagger.gen.go"), "Go module adapter was not generated")
    self.assert(generated.directory(".").exists("internal/dagger/dep.gen.go"), "Go module client was not generated")
    self.assert(generated.directory(".").exists("internal/dagger/clients/dep/dep.gen.go"), "standalone client was not generated")

    let repeated = goSdk.generateScope(ws: generated, isModule: true, name: "app", clients: [target])
    self.assert(repeated.file("dagger.json").contents == json, "repeated generation changed JSON")
    self.assert(repeated.file("dagger-module.toml").contents == toml, "repeated generation changed TOML")

    let runnable = repeated.withNewFile("main.go",
      "package main\n\nimport \"context\"\n\ntype App struct{}\n\n" +
        "func (m *App) Hello(ctx context.Context) (string, error) { return dag.Dep().Hello(ctx) }\n")
    let rebuilt = goSdk.generateScope(ws: runnable, isModule: true, name: "app", clients: [target])
    let schema = rebuilt.withWorkdir(".").moduleSource("/" + scope).clientSchemaIntrospectionJSON.contents
    self.assert(schema.contains("\"hello\""), "generated Go module did not compile and expose its function")
  }

  """The SDK passes the lock option and the selected Git commit to the helper."""
  gitClientCheck(ws: Workspace!): Void @check {
    let commit = "64645f1967d3dba6fce951dd61ae4acd8d9b0861"
    let target = moduleSource("github.com/dagger/sdk-helpers@main", refPin: commit)
    let input = ws.withWorkdir(".dagger/modules/e2e/fixtures/manifest/git-app").withNewFile("keep.txt", "keep")
    let unlocked = goSdk.generateScope(ws: input, isModule: true, name: "git-app", clients: [target])
    self.assert(!unlocked.file("dagger.json").contents.contains("\"pin\":"), "the SDK wrote a default JSON pin")
    self.assert(!unlocked.file("dagger-module.toml").contents.contains("pin ="), "the SDK wrote a default TOML pin")
    self.assert(unlocked.file("dagger-module.toml").contents.contains("source = " + JSON.encode(target.asString)),
      "the SDK changed the Git source")
    self.assert(unlocked.file("internal/dagger/clients/sdk-helpers/dagger.gen.go").contents.contains("RefPin: \"" + commit + "\""), "default output lost the generated client commit")
    let locked = goSdk(lock: true).generateScope(ws: unlocked, isModule: true, name: "git-app", clients: [target])
    self.assert(locked.file("dagger.json").contents.contains("\"pin\": " + JSON.encode(commit)), "the SDK did not write the selected JSON pin")
    self.assert(locked.file("dagger-module.toml").contents.contains("pin = " + JSON.encode(commit)), "the SDK did not write the selected TOML pin")
    let unlockedAgain = goSdk.generateScope(ws: locked, isModule: true, name: "git-app", clients: [target])
    self.assert(!unlockedAgain.file("dagger.json").contents.contains("\"pin\":"), "disabling lock retained a JSON pin")
    self.assert(!unlockedAgain.file("dagger-module.toml").contents.contains("pin ="), "disabling lock retained a TOML pin")
  }

  let assert(condition: Boolean!, message: String!): Void {
    if (!condition) { raise message }
    null
  }
}
